{
  "openapi": "3.1.0",
  "info": {
    "title": "Boston Circular Economy API",
    "description": "API for interacting with server-side functionalities",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/ping": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Ping",
        "operationId": "ping_api_v1_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Search",
        "operationId": "search_api_v1_search_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "Location data has not been generated by the ETL pipeline yet."
          }
        }
      }
    },
    "/api/v1/feedback": {
      "post": {
        "tags": [
          "public"
        ],
        "summary": "Submit User Feedback",
        "operationId": "submit_user_feedback_api_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "501": {
            "description": "Feedback submission is not implemented yet."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Activity": {
        "type": "string",
        "enum": [
          "repair_free",
          "repair_paid",
          "donation_drop",
          "donation_pick",
          "resale_buy",
          "resale_sell",
          "refill",
          "borrowing",
          "renting",
          "lending"
        ],
        "title": "Activity"
      },
      "Address": {
        "properties": {
          "street": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "postcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postcode"
          }
        },
        "type": "object",
        "title": "Address"
      },
      "Contact": {
        "properties": {
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          },
          "social": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Social"
          }
        },
        "type": "object",
        "title": "Contact"
      },
      "FeedbackInput": {
        "properties": {
          "reaction": {
            "type": "string",
            "enum": [
              "like",
              "dislike"
            ],
            "title": "Reaction",
            "description": "The user's reaction, either 'like' or 'dislike'."
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message",
            "description": "The feedback message from the user."
          }
        },
        "type": "object",
        "required": [
          "reaction"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemCategory": {
        "type": "string",
        "enum": [
          "shoes",
          "electronics",
          "clothing",
          "books",
          "furniture",
          "tools"
        ],
        "title": "ItemCategory"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results",
            "description": "A list of search results matching the search criteria."
          }
        },
        "type": "object",
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Location identifier in the form '<data_source>:<data_source_id>'. "
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "type": "array",
            "title": "Services"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "lat",
          "lon",
          "address",
          "services",
          "contact"
        ],
        "title": "SearchResult"
      },
      "Service": {
        "properties": {
          "activity": {
            "$ref": "#/components/schemas/Activity"
          },
          "item_category": {
            "$ref": "#/components/schemas/ItemCategory"
          }
        },
        "type": "object",
        "required": [
          "activity",
          "item_category"
        ],
        "title": "Service"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
